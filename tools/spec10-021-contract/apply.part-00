
const fs = require("node:fs");

function read(path) {
  return fs.readFileSync(path, "utf8");
}
function write(path, content) {
  fs.mkdirSync(require("node:path").dirname(path), { recursive: true });
  fs.writeFileSync(path, content.endsWith("\n") ? content : `${content}\n`);
}
function replaceExact(path, before, after) {
  const content = read(path);
  const count = content.split(before).length - 1;
  if (count !== 1) throw new Error(`${path}: expected one exact match, found ${count}`);
  write(path, content.replace(before, after));
}
function insertBefore(path, marker, insertion) {
  const content = read(path);
  const count = content.split(marker).length - 1;
  if (count !== 1) throw new Error(`${path}: expected one insertion marker, found ${count}`);
  write(path, content.replace(marker, `${insertion}${marker}`));
}
function insertAfter(path, marker, insertion) {
  const content = read(path);
  const count = content.split(marker).length - 1;
  if (count !== 1) throw new Error(`${path}: expected one insertion marker, found ${count}`);
  write(path, content.replace(marker, `${marker}${insertion}`));
}

